# === Authentification MCP (OBLIGATOIRE) ===
# Clé API secrète que Claude utilisera pour s'authentifier
# Générer avec : openssl rand -hex 32
MCP_API_KEY=change-me-use-openssl-rand-hex-32

# === Serveur HTTP ===
PORT=3000

# === IMAP (lecture emails) ===
IMAP_USER=your-email@example.com
IMAP_PASSWORD=your-app-password
IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_TLS=true

# === SMTP (envoi emails) ===
# Si vide, SMTP_HOST prend la valeur de IMAP_HOST
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
# Si vide, utilise IMAP_USER / IMAP_PASSWORD
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password

# === Providers courants ===
# Gmail    : IMAP_HOST=imap.gmail.com  / SMTP_HOST=smtp.gmail.com
# Outlook  : IMAP_HOST=outlook.office365.com / SMTP_HOST=smtp.office365.com / SMTP_PORT=587 / SMTP_SECURE=false
# Fastmail : IMAP_HOST=imap.fastmail.com / SMTP_HOST=smtp.fastmail.com
